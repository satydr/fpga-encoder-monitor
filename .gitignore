# ============================================================
# Vivado 生成物：3.7 GB，全部不上传（只保留源码 + 比特流）
# ============================================================
vivadoprj/*.cache/
vivadoprj/*.hw/
vivadoprj/*.sim/
vivadoprj/*.ip_user_files/
vivadoprj/.Xil/
.Xil/

# Vivado 日志与临时文件
**/*.jou
**/*.log
**/*.str
**/*.pb
**/*.dcp
**/*.rpt
**/*.xml
!vivadoprj/vivadoprj.xpr

# runs 目录只留最终比特流（impl_1 下的 .bit / .bin）
vivadoprj/*.runs/*
!vivadoprj/*.runs/impl_1/
vivadoprj/*.runs/impl_1/*
!vivadoprj/*.runs/impl_1/*.bit
!vivadoprj/*.runs/impl_1/*.bin

# ============================================================
# 工程整包备份（体积大，且内容已分散在各目录）
# ============================================================
proj_backup_*.zip

# ============================================================
# Python / 系统
# ============================================================
# ============================================================
# Windows 保留名文件（历史 bat 脚本 "> nul" 误建，系统不允许删除）
# ============================================================
nul
__pycache__/
*.pyc
Thumbs.db
.DS_Store
desktop.ini

# 本机系统文件备份，不上传
hosts_backup.txt
